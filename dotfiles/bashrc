#!/usr/bin/env bash

#-------------------------------------------------------------
#           Author: Steven Spasbo
#-------------------------------------------------------------

#-------------------------------------------------------------
# Environment stuff
#-------------------------------------------------------------
# Load first so Homebrew, GNU coreutils, etc. are on PATH for the rest of
# this file.
[ -s "$HOME/.exports" ] && . "$HOME/.exports"

if [[ -L ~/.bashrc ]]; then
  # `readlink -f` works with GNU coreutils and macOS 12.3+.
  export DOTFILE_REPO="$(dirname "$(readlink -f ~/.bashrc)")"
fi

#-------------------------------------------------------------
# Set options
#-------------------------------------------------------------
shopt -s cdspell
shopt -s dotglob
shopt -s nocaseglob

# Bash 4+ only (macOS ships bash 3.2 as /bin/bash).
if (( BASH_VERSINFO[0] >= 4 )); then
  shopt -s autocd
  shopt -s dirspell
fi

#-------------------------------------------------------------
# History stuff
#-------------------------------------------------------------
shopt -s histappend # Append to history file instead of overwriting

# Share history between bash sessions (like zsh's SHARE_HISTORY): after each
# command, append new lines to $HISTFILE, then reload it.
# Not exported, and only added once, so it doesn't grow in nested shells.
export -n PROMPT_COMMAND 2> /dev/null
case "$PROMPT_COMMAND" in
  *"history -a; history -c; history -r"*) ;;
  *) PROMPT_COMMAND="history -a; history -c; history -r${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

#-------------------------------------------------------------
# Aliases
#-------------------------------------------------------------
[ -s "$HOME/.aliases" ] && . "$HOME/.aliases"

#-------------------------------------------------------------
# Completion and prompt
#-------------------------------------------------------------
if [ -n "$HOMEBREW_PREFIX" ]; then
  [ -f "$HOMEBREW_PREFIX/etc/bash_completion.d/git-prompt.sh" ] && \
    . "$HOMEBREW_PREFIX/etc/bash_completion.d/git-prompt.sh"
  [ -f "$HOMEBREW_PREFIX/etc/bash_completion" ] && \
    . "$HOMEBREW_PREFIX/etc/bash_completion"
fi

# Fall back to no git info in the prompt if git-prompt.sh wasn't found.
type -t __git_ps1 > /dev/null || __git_ps1() { :; }

export GIT_PS1_SHOWDIRTYSTATE=1
export PS1='\[$(tput bold)\]\[$(tput setaf 7)\][\[$(tput setaf 4)\]\u\[$(tput setaf 5)\]@\[$(tput setaf 6)\]\h: \[$(tput setaf 2)\]\w\[$(tput setaf 7)\]]$(__git_ps1 " (%s)")\n\[$(tput setaf 2)\]λ \[$(tput sgr0)\]'

if command -v fzf > /dev/null; then
  eval "$(fzf --bash)"
fi
