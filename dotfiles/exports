#! /usr/bin/env bash

#-------------------------------------------------------------
# System stuff
#-------------------------------------------------------------

case "$(uname -s)" in
  Darwin)
    # Put Homebrew on PATH first so everything below can find it.
    if [ -x /opt/homebrew/bin/brew ]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi

    if [ -n "$HOMEBREW_PREFIX" ]; then
      export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

      # Use $HOMEBREW_PREFIX/opt rather than `brew --prefix` to avoid forking brew.
      export CORE_UTILS="$HOMEBREW_PREFIX/opt/coreutils"
      if [ -d "$CORE_UTILS/libexec/gnubin" ]; then
        export PATH="$CORE_UTILS/libexec/gnubin:$PATH"
        export MANPATH="$CORE_UTILS/libexec/gnuman:$MANPATH"
      fi
    fi
    ;;
  Linux)
    ;;
  *)
    ;;
esac

export EDITOR="emacs -nw"
export GIT_EDITOR="emacs -nw"
export PAGER="less"

export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"
export TZ="America/Los_Angeles"

#-------------------------------------------------------------
# History stuff
#-------------------------------------------------------------
export HISTCONTROL=ignoreboth:ignoredups:erasedups # Ignore lines that are duplicates or begin with space
export HISTSIZE=100000
export HISTFILESIZE=100000
export SAVEHIST=100000
export HISTFILE="$HOME/.history"
export HISTFORMAT='%F %T '
export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

# PATH
[[ -d "$HOME/.local/bin" ]] && PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.bin" ]] && PATH="$HOME/.bin:$PATH"
[[ -d "$HOME/bin" ]] && PATH="$HOME/bin:$PATH"

# fzf options (shell integration is loaded in zshrc/bashrc)
export FZF_DEFAULT_OPTS='--reverse --border --exact --height=50%'
# export FZF_ALT_C_COMMAND='fd --type directory'
# export FZF_CTRL_T_COMMAND="mdfind -onlyin . -name ."

# Environment specific stuff that I don't want committed.
# Load last to override exports from this file.
[[ -s "$HOME/.exports.local" ]] && . "$HOME/.exports.local"
