#!/usr/bin/env zsh

#
# Author: Steven Spasbo
#
# Interactive-shell setup. Environment/PATH lives in ~/.zshenv -> ~/.exports.

# zsh/complist is loaded in zsh-custom/config/completion.zsh.
zmodload zsh/terminfo

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.zsh-custom"

# compinit is run by oh-my-zsh; don't run it here too.
autoload -U colors && colors

ZSH_THEME="spasbo"

DISABLE_AUTO_UPDATE="true"
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="%F{red}......%f" # Matches the old zle.zsh dots

[[ -d $ZSH_CUSTOM/plugins/zsh-autosuggestions ]] && plugins+=(zsh-autosuggestions)

# Check for executables
# (pyenv works via shims set up in ~/.exports.local; its plugin isn't needed.
# docker-compose completion comes from the docker plugin.)
for p (pip aws docker bun); do
  if command -v $p > /dev/null; then
    plugins+=($p)
  fi
done

# zsh-syntax-highlighting must be the last plugin loaded, except for
# history-substring-search, which its README says must come after it.
[[ -d $ZSH_CUSTOM/plugins/zsh-syntax-highlighting ]] && plugins+=(zsh-syntax-highlighting)
plugins+=(history-substring-search)

# zsh-completions is added to fpath (per its README), not loaded as a plugin.
# Must happen before oh-my-zsh runs compinit.
[[ -d $ZSH_CUSTOM/plugins/zsh-completions/src ]] && fpath+=("$ZSH_CUSTOM/plugins/zsh-completions/src")

source "$ZSH/oh-my-zsh.sh"

# Check `zshoptions` man page for more values
setopt ALWAYS_TO_END
setopt AUTO_CD
setopt AUTO_LIST # Automatically expand menu
setopt AUTO_MENU # show completion menu on succesive tab press
setopt AUTO_PUSHD
setopt CDABLE_VARS
setopt CHASE_LINKS # chase symlinks, opposite of CHASE_DOTS
setopt COMPLETE_ALIASES
# Correct command names only. ENABLE_CORRECTION above turns on CORRECT_ALL
# (which also "corrects" arguments, e.g. new file names); turn that back off.
setopt CORRECT
unsetopt CORRECT_ALL
setopt EXTENDED_GLOB
setopt GLOB_DOTS # emacs zsh [tab] [tab] -> .zshrc .zprofile .z[a-z]+
setopt IGNOREEOF # Don't kill session with ctrl+D
setopt LIST_PACKED
setopt NO_MENU_COMPLETE
setopt NO_BEEP
setopt PROMPT_SUBST
setopt PUSHD_TO_HOME
setopt PUSHD_SILENT
setopt PUSHD_MINUS # This inverts the +/- operators.
setopt INTERACTIVE_COMMENTS # Recognize comments

unsetopt AUTO_REMOVE_SLASH
unsetopt FLOWCONTROL
unsetopt MENU_COMPLETE # do not autoselect the first completion entry

alias which='nocorrect which'

# Load all custom zsh configurations, ignoring temp files.
if [[ -d "$ZSH_CUSTOM/config" ]]; then
  for f in $ZSH_CUSTOM/config/[^.#]*.zsh(N); do
    source $f
  done
fi

zmodload -ap zsh/mapfile mapfile

autoload zmv # Move files using glob, Ex: zmv '(*).lis' '$1.txt'
autoload -U zsh-mime-setup # Set file suffixes.
zsh-mime-setup
if command -v vlc > /dev/null; then
  alias -s mp4=vlc
fi

if [[ -n $HELPDIR ]]; then
  unalias run-help 2> /dev/null
  autoload run-help
  alias help=run-help
fi

# Aliases (shared with bash). Sourced after oh-my-zsh so these win.
[[ -s "$HOME/.aliases" ]] && source "$HOME/.aliases"

alias -g G=' | grep -i'
alias -g L=' | less'

# fzf key bindings/completion. Loaded last so oh-my-zsh doesn't override ^R.
# fzf options live in ~/.exports.
command -v fzf > /dev/null && eval "$(fzf --zsh)"
